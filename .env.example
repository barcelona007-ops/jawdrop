# Copia este archivo como .env (en esta misma carpeta) y pon tu clave real detrás del =.
# El archivo .env es privado: no lo compartas ni lo subas a ningún sitio.
SERPAPI_KEY=pon_aqui_tu_clave_de_serpapi

# DataForSEO (panel «API Access»; no son los de la web)
DATAFORSEO_LOGIN=pon_aqui_el_usuario_de_la_api
DATAFORSEO_PASSWORD=pon_aqui_la_contrasena_de_la_api
